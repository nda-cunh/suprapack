vala_srcs = files(
  'BetterSearch.vala',
  'Build.vala',
  'CommandPackage.vala',
  'CommandRepo.vala',
  'CommandSystem.vala',
  'Config.vala',
  'ConfigEnv.vala',
  'ConfigUser.vala',
  'Http.vala',
  'Install.vala',
  'Log.vala',
  'Makepkg.vala',
  'Package.vala',
  'Query.vala',
  'QueueSet.vala',
  'RepoInfo.vala',
  'Repository.vala',
  'Run.vala',
  'SupraList.vala',
  'Sync.vala',
  'Uninstall.vala',
  'Utils.vala',
  'Version.vala',
  'main.vala',
  'uname.vapi'
)

executable('suprapack',
  vala_srcs,
  c_args: ['-w', '-DGETTEXT_PACKAGE="suprapack"'],
  # vala_args: '--enable-experimental',
  dependencies : [
    dependency('glib-2.0'),
    dependency('gobject-2.0'),
    dependency('gio-2.0'),
  ],
  install : true)
